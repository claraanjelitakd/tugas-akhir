@startuml
!include activity-style.puml
title AD-01A Lupa dan Reset Kata Sandi
|Pengguna Terdaftar|
start
:Pilih Lupa Kata Sandi;
:Masukkan email atau identitas akun;
|Backend|
:Cari akun dan email pemulihan;
if (Akun dapat dipulihkan?) then (ya)
  |Database|
  :Simpan hash token reset dan waktu dibuat;
  |Mail Service|
  :Kirim tautan reset ke email;
else (tidak)
  |Backend|
  :Kembalikan pesan generik;
  stop
endif
|Pengguna Terdaftar|
:Buka tautan reset dari email;
:Masukkan kata sandi baru dan konfirmasi;
|Backend|
:Validasi token, masa berlaku, email, dan konfirmasi;
if (Token dan input valid?) then (ya)
  |Database|
  :Simpan hash kata sandi baru;
  :Hapus token reset;
  |Backend|
  :Redirect ke login;
else (tidak)
  :Tampilkan pesan token atau input tidak valid;
endif
stop
@enduml
