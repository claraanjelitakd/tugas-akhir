@startuml
title AD-01 Login dan Pengalihan Dashboard
|Pengguna Terdaftar|
start
:Buka halaman login;
:Masukkan username dan kata sandi;
|Backend|
:Validasi input dan batas percobaan login;
:Autentikasi kredensial;
if (Kredensial valid?) then (ya)
  |Database|
  :Regenerasi session;
  |Backend|
  if (Alumni wajib ganti kata sandi?) then (ya)
    :Redirect ke /change-password;
  else (tidak)
    :Redirect ke dashboard sesuai role;
  endif
else (tidak)
  if (Alumni memakai password bawaan atau wajib ganti?) then (ya)
    :Bandingkan input dengan tanggal lahir atau password awal;
    if (Password awal cocok?) then (ya)
      |Database|
      :Hash ulang password dan set must_change_password = true;
      |Backend|
      :Login dan regenerasi session;
      :Redirect ke /change-password;
    else (tidak)
      :Kembalikan pesan validasi login;
    endif
  else (tidak)
    :Kembalikan pesan validasi login;
  endif
endif
stop
@enduml
