  else (tidak)
    |Backend|
    :Kembalikan pesan data sumber tidak tersedia;
    stop
  endif
else (simpan nominal)
  |Database|
  :Simpan atau perbarui satu UMP per provinsi dan tahun;
endif
|Backend|
:Redirect dengan flash sukses;
stop
