@startuml
!include activity-style.puml
title AD-06 Mengirim Undangan Evaluasi kepada Atasan
|Alumni/Admin Berwenang|
start
:Pilih alumni dan klik Kirim Email ke Atasan;
|Backend|
:Validasi biodata, email atasan, dan scope admin;
if (Data dan akses valid?) then (ya)
  |Database|
  :Kunci biodata alumni;
  :Buat atau perbarui snapshot Atasan milik alumni;
  :Cari evaluasi aktif untuk biodata;
  if (Evaluasi sudah disubmit?) then (ya)
    |Backend|
    :Tolak pengiriman ulang;
    stop
  else (tidak)
    if (Evaluasi belum ada?) then (ya)
      |Database|
      :Buat EvaluasiAtasan dengan token acak 40 karakter;
    else (sudah ada)
      |Database|
      :Pertahankan token yang belum dipakai;
      :Perbarui perusahaan dan atasan bila berubah;
    endif
  endif
  |Mail Service|
  :Kirim URL /evaluasi-atasan/{token};
  |Backend|
  if (Email berhasil dikirim?) then (ya)
    :Kembalikan flash sukses;
  else (tidak)
    :Catat kegagalan dan kembalikan flash error;
  endif
else (tidak)
  :Kembalikan pesan validasi atau akses ditolak;
endif
stop
@enduml
